{
  "projectId": "cc1e642c-09c5-4917-921f-fa5c6ca9c3c8",
  "shape": "package",
  "pkg": "bugler-frontend",
  "globalName": "Bugler",
  "srcDir": "src/components",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-css/entry.css",
  "tokensPkg": "..",
  "tokensGlob": ".ds-css/tokens.css",
  "buildCmd": "cd frontend && bun ds-css/build.ts",
  "extraFonts": [
    "node_modules/@fontsource/ibm-plex-sans/latin-400.css",
    "node_modules/@fontsource/ibm-plex-sans/latin-500.css",
    "node_modules/@fontsource/ibm-plex-sans/latin-600.css",
    "node_modules/@fontsource/ibm-plex-sans/latin-ext-400.css",
    "node_modules/@fontsource/ibm-plex-sans/latin-ext-500.css",
    "node_modules/@fontsource/ibm-plex-sans/latin-ext-600.css",
    "node_modules/@fontsource/ibm-plex-mono/latin-400.css",
    "node_modules/@fontsource/ibm-plex-mono/latin-500.css",
    "node_modules/@fontsource/ibm-plex-mono/latin-ext-400.css",
    "node_modules/@fontsource/ibm-plex-mono/latin-ext-500.css"
  ],
  "docsDir": "../.design-sync/docs",
  "readmeHeader": ".design-sync/conventions.md",
  "overrides": {
    "Select": { "cardMode": "single", "primaryStory": "OpenWithGroups" },
    "Combobox": { "cardMode": "single", "primaryStory": "OpenWithKeys" },
    "Dialog": { "cardMode": "single", "primaryStory": "Destructive", "viewport": "720x520" },
    "Chart": { "cardMode": "single", "primaryStory": "LogVolume", "viewport": "720x400" },
    "Resizable": { "cardMode": "single", "primaryStory": "LogDetail", "viewport": "720x360" },
    "DetailPanel": { "cardMode": "single", "primaryStory": "ListAndDetail", "viewport": "720x360" },
    "DataTable": { "cardMode": "single", "primaryStory": "Sorted", "viewport": "720x360" }
  },
  "componentSrcMap": {
    "Button": "src/components/ui/button.tsx",
    "Card": "src/components/ui/card.tsx",
    "Chart": "src/components/ui/chart.tsx",
    "Checkbox": "src/components/ui/checkbox.tsx",
    "Combobox": "src/components/ui/combobox.tsx",
    "DataTable": "src/components/ui/data-table.tsx",
    "DetailPanel": "src/components/ui/detail-panel.tsx",
    "Dialog": "src/components/ui/dialog.tsx",
    "FilterChip": "src/components/ui/filter-chip.tsx",
    "FilterRail": "src/components/ui/filter-rail.tsx",
    "FilterSelect": "src/components/ui/filter-select.tsx",
    "Input": "src/components/ui/input.tsx",
    "Label": "src/components/ui/label.tsx",
    "Resizable": "src/components/ui/resizable.tsx",
    "Select": "src/components/ui/select.tsx",
    "Table": "src/components/ui/table.tsx",
    "Textarea": "src/components/ui/textarea.tsx"
  }
}
