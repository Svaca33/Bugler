# Copy to .env beside docker-compose.prod.yml and fill in. Never committed — .env is ignored.
# What each of these means, and what to ask of whoever runs the database, is in DEPLOYMENT.md.

# The PostgreSQL this Bugler uses. host.docker.internal reaches the machine the container runs on.
BUGLER_DB_HOST=host.docker.internal
BUGLER_DB_PORT=5432
BUGLER_DB_NAME=bugler
BUGLER_DB_USER=bugler
BUGLER_DB_PASSWORD=

# How Bugler is reached from outside. Every link in a mail or a chat message is built from it, and
# password reset is offered only when it is set.
BUGLER_PUBLIC_BASE_URL=https://bugler.example.com

# The mail relay. Leave BUGLER_SMTP_HOST empty to disable mail entirely: alerts then reach their
# subscribers only in the UI, and password reset disappears rather than promising a mail that
# never comes.
BUGLER_SMTP_HOST=
BUGLER_SMTP_PORT=25
BUGLER_SMTP_FROM=bugler@example.com
# Only where the relay asks to be authenticated; uncomment the matching lines in the compose file.
# BUGLER_SMTP_USERNAME=
# BUGLER_SMTP_PASSWORD=

# 127.0.0.1 keeps the UI reachable only through a reverse proxy on this same machine. Set to
# 0.0.0.0 when the proxy runs elsewhere, and let the firewall decide who gets there.
BUGLER_APP_BIND=127.0.0.1
