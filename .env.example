# Copy to .env beside docker-compose.prod.yml and fill in. Never committed — .env is ignored.
# What each of these means, and what to ask of whoever runs the database, is in DEPLOYMENT.md.

# The published image to run — the version you were told to install. Always a version, never
# `latest`: rolling back is then this one line and a restart, and two servers on the same tag are
# running the same thing. A version looks like 0.20.0; which one is current cannot be written here,
# since writing it would itself be a commit and make it the previous one. The releases are listed
# at https://github.com/Svaca33/Bugler/releases — the image is public, so nothing has to sign in
# to pull it.
BUGLER_IMAGE=ghcr.io/svaca33/bugler:

# The PostgreSQL this Bugler uses. host.docker.internal reaches the machine the container runs on.
BUGLER_DB_HOST=host.docker.internal
BUGLER_DB_PORT=5432
BUGLER_DB_NAME=bugler
BUGLER_DB_USER=bugler
BUGLER_DB_PASSWORD=

# How Bugler is reached from outside. Every link in a mail or a chat message is built from it,
# password reset is offered only when it is set — and the scheme here is the only thing that tells
# Bugler whether TLS stands in front of it, because behind the proxy it sees nothing but plain HTTP.
# An https address gets the Session cookie minted `Secure` and host-locked; an http one does not
# (ADR 0019). Required: the compose file refuses to start without it.
BUGLER_PUBLIC_BASE_URL=https://bugler.example.com

# The mail relay. Leave BUGLER_SMTP_HOST empty to disable mail entirely: alerts then reach their
# subscribers only in the UI, and password reset disappears rather than promising a mail that
# never comes.
BUGLER_SMTP_HOST=
BUGLER_SMTP_PORT=25
BUGLER_SMTP_FROM=bugler@example.com
# Only where the relay asks to be authenticated; uncomment the matching lines in the compose file.
# BUGLER_SMTP_USERNAME=
# BUGLER_SMTP_PASSWORD=

# 127.0.0.1 keeps the UI reachable only through a reverse proxy on this same machine. Set to
# 0.0.0.0 when the proxy runs elsewhere, and let the firewall decide who gets there.
BUGLER_APP_BIND=127.0.0.1

# The machine door (MCP), which lets an agent at somebody's editor read this server's telemetry.
# Nothing here is enough on its own: the port has to be published in docker-compose.prod.yml (that
# line is commented out too), an Admin has to open the door on Administration → Server, and a person
# has to hold a Machine Delegation they issued themselves. Uncomment both of these when you mean to,
# and put the door behind the same TLS as the UI — a Delegation's secret travels in every call.
# The URL is host and port with no path; Bugler appends /mcp itself, and it is only ever printed
# into the connect command a user copies (ADR 0030).
# BUGLER_PUBLIC_MCP_URL=https://bugler.example.com
# BUGLER_MCP_BIND=127.0.0.1

# The AI provider Bugler may ask for a reading of an Episode's evidence. Usually left unset here and
# entered on Administration → Server instead, where it is stored in the database and the key never
# touches this machine. Uncomment the matching Ai__ lines in the compose file to use it from here.
# BUGLER_AI_API_KEY=
