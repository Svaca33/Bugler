{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "bugler": "Host=localhost;Port=5432;Database=bugler;Username=bugler;Password=bugler"
  },
  "Kestrel": {
    "Endpoints": {
      "App": {
        "Url": "http://0.0.0.0:8080"
      },
      "OtlpGrpc": {
        "Url": "http://0.0.0.0:4317",
        "Protocols": "Http2"
      },
      "OtlpHttp": {
        "Url": "http://0.0.0.0:4318",
        "Protocols": "Http1AndHttp2"
      }
    }
  },
  "Ingestion": {
    "BufferCapacity": 50000,
    "MaxBatchSize": 5000
  },
  "Server": {
    "PublicBaseUrl": "http://localhost:8080"
  },
  "Mail": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "Automatic",
      "Username": "",
      "Password": "",
      "From": ""
    }
  },
  "Ai": {
    "Provider": "Anthropic",
    "BaseUrl": "",
    "ApiKey": "",
    "Model": "",
    "PatienceSeconds": 60
  },
  "Alerting": {
    "PollIntervalSeconds": 15
  }
}
